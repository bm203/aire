{% extends "base.html.j2" %}
{% block title %}AIRE — event {{ event.event_id }}{% endblock %}
{% block content %}
<p><a href="/">← overview</a> ·
  <a href="/session?id={{ event.session_id | urlencode }}">← session {{ event.session_id }}</a></p>
<h1>Event <code>{{ event.event_id }}</code></h1>
<table>
  <tbody>
    <tr><th>Type</th><td><code>{{ event.event_type }}</code></td></tr>
    <tr><th>Timestamp</th><td>{{ event.ts }}</td></tr>
    <tr><th>Session</th><td><code>{{ event.session_id }}</code></td></tr>
    <tr><th>App</th><td>{{ event.app }}</td></tr>
    <tr><th>Hash (sha256)</th><td><code>{{ event.hash }}</code></td></tr>
    <tr><th>Prev hash</th><td><code>{{ event.prev_hash }}</code></td></tr>
  </tbody>
</table>

<h2>Payload</h2>
<pre>{{ event.payload }}</pre>
{% if event.truncated %}
<p class="meta">Payload truncated to {{ max_chars }} chars for display — the full,
  hashed payload remains in the evidence store.</p>
{% endif %}
{% endblock %}
