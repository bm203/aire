{% extends "base.html.j2" %}
{% block title %}AIRE: {{ report.store_path }}{% endblock %}
{% block content %}

<header class="page-head">
  <h1>{{ report.title }}</h1>
  <p class="meta">
    aire {{ report.aire_version }} &middot; store <code>{{ report.store_path }}</code>
    &middot; generated {{ report.generated_at }}
  </p>
</header>

{# An intact chain is the expected state and is reported in the KPI row; only
   a broken chain warrants an alert. #}
{% if not report.chain.ok %}
<div class="banner bad">
  <strong>Evidence chain broken at sequence {{ report.chain.first_bad_seq }}.</strong>
  {{ report.chain.reason }} Investigate before relying on any result in this report.
</div>
{% endif %}

<section class="kpis">
  <div class="kpi">
    <span class="kpi-value">{{ report.total_events }}</span>
    <span class="kpi-label">Events recorded</span>
  </div>
  <div class="kpi">
    <span class="kpi-value">{{ report.sessions | length }}</span>
    <span class="kpi-label">Sessions</span>
  </div>
  <div class="kpi">
    <span class="kpi-value">{{ matrix.grand_total }}</span>
    <span class="kpi-label">Findings</span>
  </div>
  <div class="kpi">
    <span class="kpi-value kpi-{{ 'ok' if report.chain.ok else 'bad' }}">
      {{ "Intact" if report.chain.ok else "Broken" }}
    </span>
    <span class="kpi-label">Chain, {{ report.chain.events_verified }} verified</span>
  </div>
  <div class="kpi">
    <span class="kpi-value">{{ report.overall_risk_score }}</span>
    <span class="kpi-label">
      Overall risk
      <span class="sev sev-{{ report.overall_risk_level.value }}">{{ report.overall_risk_level.value }}</span>
    </span>
  </div>
</section>

{% if report.sessions %}
<div class="grid-2">

  <section class="card">
    <h2>Findings by severity</h2>
    {% if severity_bar %}
    <div class="stackbar">
      {% for seg in severity_bar %}
      <span class="seg sev-{{ seg.severity }} {{ seg.pct_class }}" title="{{ seg.severity }}: {{ seg.count }}"></span>
      {% endfor %}
    </div>
    <table class="legend">
      <tbody>
      {% for seg in severity_bar %}
        <tr>
          <td><span class="swatch sev-{{ seg.severity }}"></span> {{ seg.severity }}</td>
          <td class="num">{{ seg.count }}</td>
          <td class="num meta">{{ seg.share }}%</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="empty">No findings recorded.</p>
    {% endif %}
  </section>

  <section class="card">
    <h2>Findings by control</h2>
    <table class="matrix">
      <thead>
        <tr>
          <th>Control</th>
          {% for sev in severities %}<th class="num">{{ sev }}</th>{% endfor %}
          <th class="num">Total</th>
        </tr>
      </thead>
      <tbody>
      {% for row in matrix.rows %}
        <tr>
          <td><code>{{ row.origin }}</code></td>
          {% for cell in row.cells %}
            <td class="num {{ cell.heat }}">{{ cell.count or "" }}</td>
          {% endfor %}
          <td class="num total">{{ row.total }}</td>
        </tr>
      {% endfor %}
      </tbody>
      <tfoot>
        <tr>
          <th>Total</th>
          {% for t in matrix.totals %}<th class="num">{{ t or "" }}</th>{% endfor %}
          <th class="num">{{ matrix.grand_total }}</th>
        </tr>
      </tfoot>
    </table>
  </section>

</div>

<section class="card">
  <div class="card-head">
    <h2>Sessions</h2>
    <a href="/findings">View all findings &rsaquo;</a>
  </div>
  <table>
    <thead>
      <tr><th>Session</th><th>Risk</th><th class="risk-col">Score</th><th class="num">Findings</th></tr>
    </thead>
    <tbody>
    {% for session in report.sessions %}
      <tr>
        <td><a href="/session?id={{ session.session_id | urlencode }}"><code>{{ session.session_id }}</code></a></td>
        <td><span class="sev sev-{{ session.risk_level.value }}">{{ session.risk_level.value }}</span></td>
        <td class="risk-col">
          <meter class="riskmeter" value="{{ session.risk_score }}" min="0" max="100"
                 low="25" high="60" optimum="0">{{ session.risk_score }}</meter>
          <span class="score">{{ session.risk_score }}</span>
        </td>
        <td class="num">{{ session.findings | length }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</section>
{% else %}
<p class="empty">No findings recorded yet. Run <code>aire evaluate</code> and
  <code>aire detect</code> against this store, then reload.</p>
{% endif %}

{% if report.recommendations %}
<section class="card">
  <h2>Recommended actions</h2>
  <ol class="actions">{% for r in report.recommendations %}<li>{{ r }}</li>{% endfor %}</ol>
</section>
{% endif %}

{% endblock %}
